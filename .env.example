# Copy this file to `.env` and adjust the values. The project also creates
# `.env` automatically on the first run with a random DJANGO_SECRET_KEY.

# Random key used to sign sessions and tokens. Never reuse it in production.
DJANGO_SECRET_KEY=

# 1 to enable Django debug mode, 0 to disable it.
DJANGO_DEBUG=1

# Comma separated list of accepted Host header values.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma separated list of trusted origins, needed for POST requests.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Credentials used by `python manage.py bootstrap_admin`.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Credentials used by `python manage.py bootstrap_editor`.
EDITOR_USERNAME=editor
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=
